<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>English Speaking Course</title>

  <style>
    /* Reset & base */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f5f0e8;
      color: #222;
      min-height: 100vh;
    }

    /* Navigation */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 3rem;
      background: #d4c7b8;
      font-weight: 600;
    }
    nav .logo {
      font-weight: 900;
      font-size: 1.25rem;
      cursor: pointer;
    }
    nav ul {
      list-style: none;
      display: flex;
      gap: 2rem;
    }
    nav ul li a {
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    /* Sections */
    .section {
      padding: 50px 3rem;
      max-width: 900px;
      margin: 30px auto;
      box-shadow: 0 0 15px rgba(0,0,0,0.1);
      border-radius: 8px;
      background: #fff;
      display: none;
    }

    /* Hero */
    #heroSection {
      height: 70vh;
      background: url("static/background.jpg") center/cover no-repeat;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: #ede6dc;
      text-shadow: 0 0 10px rgba(0,0,0,0.7);
    }

    h1 { font-size: 2.5rem; }
    h2 { text-align: center; margin-bottom: 20px; }
    p {
      font-size: 1.125rem;
      line-height: 1.6;
      text-align: center;
    }

    button {
      cursor: pointer;
      background-color: #d4c7b8;
      border: none;
      padding: 12px 25px;
      font-size: 1rem;
      border-radius: 6px;
      font-weight: 600;
    }
    button:hover {
      background-color: #b3a48b;
    }

    /* Learning Materials */
    .materials-list {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin: 25px 0;
      flex-wrap: wrap;
    }

    .pdf-container {
      width: 100%;
      height: 650px;
      margin-top: 20px;
      display: none;
    }

    .pdf-container iframe {
      width: 100%;
      height: 100%;
      border: none;
      border-radius: 6px;
    }
  </style>

  <!-- Static JS -->
  <script src="static/activity.js" defer></script>
</head>

<body>

<nav>
  <div class="logo" id="homeLink">ENGLISH SPEAKING COURSE</div>
  <ul>
    <li><a id="aboutLink">About</a></li>
    <li><a id="speakingTestLink">Speaking Test</a></li>
    <li><a id="activityLink">Activity</a></li>
    <li><a id="materialsLink">Learning Materials</a></li>
  </ul>
</nav>

<section id="heroSection">
  <h1>EMPOWERING YOUR EDUCATIONAL JOURNEY</h1>
</section>

<section id="about-us" class="section">
  <h2>About Us</h2>
  <p>
    Our English Speaking Course empowers learners with interactive coaching,
    pronunciation practice, and structured learning materials.
  </p>
</section>

<section id="speaking-test" class="section">
  <h2>English Speaking Coach</h2>
  <button onclick="startApp()">▶ Start Coaching</button>
</section>

<section id="activity" class="section">
  <h2>Your Activity</h2>
  <p>Exercises completed: <span id="activityCount">0</span></p>
  <p>Last active: <span id="activityLast">Never</span></p>
</section>

<!-- Learning Materials -->
<section id="materials" class="section">
  <h2>Learning Materials</h2>
  <p>
    Use the books below to strengthen your grammar and structure alongside speaking practice.
  </p>

  <div class="materials-list">
    <button onclick="openBook('Beginner_English_starter.pdf')">
      📘 Beginner English – Starter
    </button>

    <button onclick="openBook('Beginner_English_level_1.pdf')">
      📗 Beginner English – Level 1
    </button>

    <button onclick="openBook('Beginner_English_level_premium.pdf')">
      📕 Beginner English – Premium
    </button>
  </div>

  <div class="pdf-container" id="pdfContainer">
    <iframe id="pdfViewer"></iframe>
  </div>
</section>

<script>
  function hideAllSections() {
    document.querySelectorAll('.section').forEach(s => s.style.display = 'none');
    document.getElementById('heroSection').style.display = 'none';
  }

  document.getElementById('homeLink').onclick = () => {
    hideAllSections();
    document.getElementById('heroSection').style.display = 'flex';
  };

  document.getElementById('aboutLink').onclick = () => {
    hideAllSections();
    document.getElementById('about-us').style.display = 'block';
  };

  document.getElementById('speakingTestLink').onclick = () => {
    hideAllSections();
    document.getElementById('speaking-test').style.display = 'block';
  };

  document.getElementById('activityLink').onclick = () => {
    hideAllSections();
    document.getElementById('activity').style.display = 'block';

    if (typeof getActivity === "function") {
      document.getElementById('activityCount').textContent = getActivity();
      document.getElementById('activityLast').textContent = getLastActive();
    }
  };

  document.getElementById('materialsLink').onclick = () => {
    hideAllSections();
    document.getElementById('materials').style.display = 'block';
  };

  function openBook(filename) {
    const viewer = document.getElementById('pdfViewer');
    const container = document.getElementById('pdfContainer');

    viewer.src = "static/books/" + filename;
    container.style.display = 'block';
    container.scrollIntoView({ behavior: 'smooth' });
  }
</script>

</body>
</html>
